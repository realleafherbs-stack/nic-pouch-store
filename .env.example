# Public analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# NIC POUCH CRM catalog sync (server/build only; never expose CRM_API_KEY in NEXT_PUBLIC_*).
CRM_CATALOG_SYNC=false
CRM_API_BASE_URL=https://www.ducks.co.il/api
CRM_SITE_SLUG=nic-pouch
CRM_API_KEY=

# Public — used by the browser for coupon validation at checkout (public endpoint, no key needed).
NEXT_PUBLIC_CRM_URL=https://www.ducks.co.il
NEXT_PUBLIC_CRM_SITE_SLUG=nic-pouch

# This site's own canonical URL — used for Hyp Pay success/failure redirect
# URLs and absolute SEO URLs. Must be the real deployed origin, not a fallback.
NEXT_PUBLIC_SITE_URL=https://nicpouch.co.il

# Payper — server-only. Never prefix these with NEXT_PUBLIC_.
PAYPER_API_KEY=
PAYPER_API_USER=

# Hyp Pay — server-only, this site's own terminal. Never reuse another
# site's terminal even if it's the same business — each is a separate
# merchant account. Get these from the client's Hyp Pay onboarding.
HYP_MASOF=
HYP_KEY=
HYP_PASSP=

# Contact form notifications — shared mailbox used across all sites (same
# account/app-password as xvape and polarizedx). Server-only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# CRM revalidate ping — the CRM calls /api/revalidate here whenever a blog
# post is published. Must match the Site record's revalidateSecret in the CRM.
REVALIDATE_SECRET=
